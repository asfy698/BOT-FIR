import os
import requests
import base64
import io
from PIL import Image
import config


class VisionAPI:
    def __init__(self, api_key=None):
        self.api_key = api_key or config.HF_API_KEY
        self.api_url = "https://router.huggingface.co/v1/chat/completions"
        # Lightweight vision model currently served by the HF router.
        self.model = "google/gemma-3-4b-it"

    def get_image_base64(self, image_path):
        """Convert local image → base64 (no prefix)."""
        if not os.path.exists(image_path):
            return None

        try:
            with Image.open(image_path) as img:
                if img.mode != "RGB":
                    img = img.convert("RGB")

                img.thumbnail((1024, 1024), Image.Resampling.LANCZOS)

                buffer = io.BytesIO()
                img.save(buffer, format="JPEG", quality=85)

                return base64.b64encode(buffer.getvalue()).decode("utf-8")

        except Exception as e:
            print(f"Image processing error: {e}")
            return None

    def _build_image_content(self, image_input):
        """
        Accepts either:
        - local file path
        - http/https URL
        """
        if image_input.startswith("http://") or image_input.startswith("https://"):
            return {
                "type": "image_url",
                "image_url": {"url": image_input}
            }

        # Otherwise treat as local file
        b64_image = self.get_image_base64(image_input)
        if not b64_image:
            return None

        return {
            "type": "image_url",
            "image_url": {
                "url": f"data:image/jpeg;base64,{b64_image}"
            }
        }

    def analyze_image(self, image_input, prompt="Describe this scene in one short sentence."):
        """Main function"""

        image_content = self._build_image_content(image_input)
        if not image_content:
            return "Invalid image input."

        headers = {
            "Authorization": f"Bearer {self.api_key}",
            "Content-Type": "application/json",
        }

        payload = {
            "model": self.model,
            "messages": [
                {
                    "role": "user",
                    "content": [
                        {"type": "text", "text": prompt},
                        image_content
                    ]
                }
            ],
            "max_tokens": 100
        }

        try:
            response = requests.post(
                self.api_url,
                headers=headers,
                json=payload,
                timeout=60
            )

            # 🔍 DEBUG (keep this while testing)
            print("STATUS:", response.status_code)
            print("RESPONSE:", response.text)

            if response.status_code == 503:
                return "Model is loading. Try again in ~20 seconds."

            response.raise_for_status()
            data = response.json()

            return data["choices"][0]["message"]["content"]

        except requests.exceptions.RequestException as e:
            return f"API Error: {str(e)}"


